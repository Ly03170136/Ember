; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"ï»¿config_version"=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ember (余烬)"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio_buses]

bus/layout={
"bus_count": 3,
"buses": [{
"band_limit_gain": 0.0,
"channel": 0,
"detect_peak": 0.0,
"disable_feedback": false,
"name": "Master",
"solo": false,
"volume": 1.0
}, {
"band_limit_gain": 0.0,
"channel": 1,
"detect_peak": 0.0,
"disable_feedback": false,
"name": "Music",
"solo": false,
"volume": 1.0
}, {
"band_limit_gain": 0.0,
"channel": 2,
"detect_peak": 0.0,
"disable_feedback": false,
"name": "SFX",
"solo": false,
"volume": 1.0
}]
}

[autoload]

GameManager="*res://scripts/globals/game_manager.gd"
ItemDB="*res://scripts/globals/item_db.gd"
RecipeDB="*res://scripts/globals/recipe_db.gd"
BuildingDB="*res://scripts/globals/building_db.gd"
ArtAssets="*res://scripts/globals/art_assets.gd"
PlayerSprite="*res://scripts/globals/player_sprite.gd"
TechTree="*res://scripts/globals/tech_tree.gd"
PowerSystem="*res://scripts/globals/power_system.gd"
AudioManager="*res://scripts/globals/audio_manager.gd"
SaveManager="*res://scripts/globals/save_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/size/window_width=1280
window/size/window_height=720
window/size/fullscreen=false

